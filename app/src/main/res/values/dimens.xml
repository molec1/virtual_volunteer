<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Corners -->
    <dimen name="card_corner_radius">28dp</dimen>
    <dimen name="button_corner_full">28dp</dimen>
    <dimen name="fab_corner_pill">28dp</dimen>
    <dimen name="image_corner_radius">18dp</dimen>
    <dimen name="chip_corner_radius">12dp</dimen>

    <!-- Elevation (soft float) — wider than the original 6dp so the native shadow spreads into
         a soft ambient glow instead of a tight, dark-edged line. The gap around each card
         (race_row_vertical_gap, dashboard row margins, etc.) was widened to match, since a
         shadow this size needs clearance or the parent's default child-clipping crops most of
         it away, which is what made earlier attempts look "flat". -->
    <dimen name="card_elevation">12dp</dimen>
    <dimen name="fab_elevation">10dp</dimen>
    <dimen name="app_bar_elevation">0dp</dimen>

    <!-- Spacing -->
    <dimen name="card_padding">20dp</dimen>
    <dimen name="screen_horizontal_padding">24dp</dimen>
    <dimen name="section_spacing_large">28dp</dimen>
    <dimen name="section_spacing_medium">18dp</dimen>
    <dimen name="list_content_padding">12dp</dimen>
    <dimen name="list_item_gap">14dp</dimen>
    <dimen name="face_thumb_inner_padding">4dp</dimen>

    <!-- Large edge-to-edge page title (Events list and similar top screens) -->
    <dimen name="screen_title_top_padding">48dp</dimen>
    <dimen name="screen_title_horizontal_padding">32dp</dimen>

    <!-- Event list thumbnail -->
    <dimen name="race_row_thumb_size">92dp</dimen>

    <!-- Event list card: tighter inner padding than the shared defaults, so the card reads as
         fuller/denser rather than mostly empty space. The card-to-card gap is kept generous
         enough to give the (now wider) elevation shadow room to actually render. -->
    <dimen name="race_row_card_padding">14dp</dimen>
    <dimen name="race_row_vertical_gap">12dp</dimen>
    <!-- Concentric with the card corner: card_corner_radius (28dp) − race_row_card_padding
         (14dp) so the thumbnail's rounding lines up with the outer card curvature. -->
    <dimen name="race_row_thumb_corner_radius">14dp</dimen>

    <!-- Protocol participant rows: keep compact — phone layout is pixel-tight.
         Thumb is 2dp under the previous 56dp so faces stay readable while the row
         sits a touch shorter; inter-row gap is half of the earlier soft-shadow margin. -->
    <dimen name="participant_row_thumb_size">54dp</dimen>
    <dimen name="participant_row_action_button_size">36dp</dimen>
    <dimen name="participant_row_vertical_padding">4dp</dimen>
    <dimen name="participant_row_vertical_gap">4dp</dimen>
    <!-- Gaps between the stacked bottom cards on race detail (Export → … → Debug). -->
    <dimen name="race_detail_bottom_card_gap">14dp</dimen>
    <dimen name="identity_registry_card_thumb_height">112dp</dimen>
    <dimen name="min_touch_target">48dp</dimen>
</resources>
