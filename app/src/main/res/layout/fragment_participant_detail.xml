<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Fixed edge-to-edge header: back button + large page title -->
    <LinearLayout
        android:id="@+id/participantDetailHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_title_horizontal_padding"
        android:paddingTop="@dimen/screen_title_top_padding"
        android:paddingEnd="@dimen/screen_title_horizontal_padding"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.VirtualVolunteer.IconButton.Tonal"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/action_back_cd"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/participantDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/participant_detail_title"
            android:textAppearance="@style/TextAppearance.VirtualVolunteer.PageTitle" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/participantDetailHeader">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/section_spacing_medium"
        android:paddingBottom="36dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.VirtualVolunteer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/participantDetailThumbnail"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:background="@drawable/bg_placeholder_photo"
                    android:contentDescription="@string/participant_thumb_cd"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.VirtualVolunteer.RoundedThumb"
                    tools:ignore="ImageContrastCheck" />

                <!-- The scanned code is now the page title (participantDetailTitle); the profile
                     card only adds the internal protocol row id, so the code is not repeated. -->
                <TextView
                    android:id="@+id/participantDetailId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing_medium"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.VirtualVolunteer.Meta"
                    tools:text="Protocol row #123" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/participantDetailEmbeddingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing_large"
            android:text="@string/participant_detail_embeddings_header"
            android:textAppearance="@style/TextAppearance.VirtualVolunteer.SectionLabel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/participantEmbeddingsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="4dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_participant_embedding_preview" />

        <TextView
            android:id="@+id/participantDetailNoEmbeddings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/participant_detail_no_embeddings"
            android:textAppearance="@style/TextAppearance.VirtualVolunteer.Meta"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveFaceData"
            style="@style/Widget.VirtualVolunteer.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing_medium"
            android:text="@string/participant_detail_remove_face_data" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteDeviceIdentity"
            style="@style/Widget.VirtualVolunteer.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/participant_detail_delete_device_identity"
            android:textColor="?attr/colorError" />

        <TextView
            android:id="@+id/racesListHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing_large"
            android:text="@string/participant_detail_races_header"
            android:textAppearance="@style/TextAppearance.VirtualVolunteer.SectionLabel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/participantRacesRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingTop="@dimen/list_content_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_participant_detail_race_row"
            tools:visibility="visible" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
