<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.VirtualVolunteer.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_horizontal_padding"
    android:layout_marginVertical="@dimen/race_row_vertical_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/race_row_card_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/raceStartThumb"
            android:layout_width="@dimen/race_row_thumb_size"
            android:layout_height="@dimen/race_row_thumb_size"
            android:layout_marginEnd="@dimen/race_row_card_padding"
            android:background="@drawable/bg_placeholder_photo"
            android:contentDescription="@string/race_list_start_thumb_cd"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.VirtualVolunteer.RaceThumb"
            tools:ignore="ImageContrastCheck"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/raceRowMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/raceDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.VirtualVolunteer.EventDate"
                tools:text="18 Apr 2026" />

            <TextView
                android:id="@+id/raceTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textAppearance="@style/TextAppearance.VirtualVolunteer.EventTime"
                tools:text="14:32" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteRace"
            style="@style/Widget.VirtualVolunteer.IconButton.Tonal"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:layout_gravity="bottom"
            android:contentDescription="@string/btn_delete_race_cd"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
