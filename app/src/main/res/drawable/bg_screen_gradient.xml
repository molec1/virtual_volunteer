<?xml version="1.0" encoding="utf-8"?>
<!-- Very light lavender background with an almost-invisible radial highlight from the top-left. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="420dp"
        android:centerX="0.12"
        android:centerY="0.02"
        android:startColor="@color/background_gradient_tint"
        android:centerColor="@color/background_light"
        android:endColor="@color/background_light" />
</shape>
